---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${basePath}${p}` || '/';
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title={`${post.data.title} — Bach Nguyen`}
  description={post.data.description}
  kernel="running…"
  footMeta="writing.ipynb · kernel: python 3"
>
  <section class="cell">
    <div class="gutter">In [1]:</div>
    <div class="body-cell md">
      <p class="eyebrow">writing · {fmtDate(post.data.pubDate)} · {post.data.tags.join(' · ')}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="btn-row"><a class="btn" href={href('/blog')}>← all writing</a></div>
    </div>
  </section>

  <section class="cell">
    <div class="gutter">In [2]:</div>
    <div class="body-cell md md-content">
      <Content />
    </div>
  </section>
</BaseLayout>
