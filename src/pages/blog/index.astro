---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${basePath}${p}` || '/';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const readTime = (body: string | undefined) =>
  Math.max(1, Math.round((body ?? '').split(/\s+/).filter(Boolean).length / 200));
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title="Writing — Bach Nguyen"
  description="Notes on practical ML: reproducibility, baselines, and feature engineering."
  footMeta={`writing.ipynb · ${posts.length} cells · kernel: python 3`}
>
  <section class="cell">
    <div class="gutter">In [1]:</div>
    <div class="body-cell md">
      <p class="eyebrow">/writing</p>
      <h1>Markdown cells</h1>
      <p class="lead">Short notes on the unglamorous parts of doing ML well — the habits that decide whether a result survives contact with reality.</p>
    </div>
  </section>

  <section class="cell">
    <div class="gutter out">Out[1]:</div>
    <div class="body-cell output">
      {posts.map((post) => (
        <a class="post" href={href(`/blog/${post.id}`)}>
          <div class="post-meta">
            <span># {fmtDate(post.data.pubDate)}</span>
            <span>{post.data.tags.join(' · ')}</span>
            <span>~{readTime(post.body)} min</span>
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="cell">
    <div class="gutter blank">In [ ]:</div>
    <div class="body-cell md">
      <p class="muted">More notes whenever a project teaches me something worth writing down. In the meantime, the <a href={href('/projects/expected-goals')}>xG notebook</a> is the long-form version of how I think.</p>
    </div>
  </section>
</BaseLayout>
