---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.notebook !== false)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${basePath}${p}` || '/';

const domain = project.data.domainLabel ?? project.data.domain;
const footMeta = `${project.data.experiment ?? project.id}.ipynb · kernel: python 3`;
---

<BaseLayout
  title={`${project.data.title} — Bach Nguyen`}
  description={project.data.summary}
  kernel="running…"
  footMeta={footMeta}
>
  <!-- title -->
  <section class="cell">
    <div class="gutter">In [1]:</div>
    <div class="body-cell md">
      <p class="eyebrow">notebook · {domain} · {project.data.year ?? project.data.period}</p>
      <h1>{project.data.title}</h1>
      <p class="lead">{project.data.summary}</p>
      <div class="chips">{project.data.tags.map((t, i) => <span class={i === 0 ? 'chip accent' : 'chip'}>{t}</span>)}</div>
      <div class="btn-row">
        {project.data.github && <a class="btn" href={project.data.github} target="_blank" rel="noopener">github →</a>}
        <a class="btn" href={href('/projects')}>← all projects</a>
      </div>
    </div>
  </section>

  <!-- rendered notebook body -->
  <section class="cell">
    <div class="gutter">In [2]:</div>
    <div class="body-cell md md-content">
      <Content />
    </div>
  </section>

  <!-- CTA -->
  <section class="cell">
    <div class="gutter blank">In [ ]:</div>
    <div class="body-cell md">
      <div class="btn-row">
        <a class="btn primary" href={href('/#contact')}>talk to me about this →</a>
        {project.data.github && <a class="btn" href={project.data.github} target="_blank" rel="noopener">read the code</a>}
      </div>
    </div>
  </section>
</BaseLayout>
