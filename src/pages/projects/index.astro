---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${basePath}${path}`;
---

<BaseLayout
  title="Projects | Bach"
  description="Case studies covering machine learning, finance analytics, and computer vision projects."
>
  <Header />
  <main id="main-content" class="container list-page">
    <header class="section-header">
      <p class="kicker">// Work</p>
      <h1>Projects</h1>
      <p class="lead">A detailed look into selected technical work and outcomes.</p>
    </header>

    <div class="grid grid-2">
      {projects.map((project) => (
        <article class="card project-card reveal" data-domain={project.data.domain}>
          <div class="project-card-head">
            <h2><a href={href(`/projects/${project.id}`)}>{project.data.title}</a></h2>
            <span class="domain-badge">
              {project.data.domainLabel ?? project.data.domain.toUpperCase()}
            </span>
          </div>
          <p class="meta">{project.data.summary}</p>
          <p class="meta">{project.data.role} • {project.data.period}</p>
          <div class="tags">
            {project.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <div class="project-actions">
            <a href={href(`/projects/${project.id}`)} class="card-link">Read case study →</a>
            {project.data.github && (
              <a href={project.data.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            )}
            {project.data.demo && (
              <a href={project.data.demo} target="_blank" rel="noopener noreferrer">Live Demo</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
