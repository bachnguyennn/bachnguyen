---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${basePath}${p}` || '/';
const asset = (p: string) => `${basePath}/${p}`;

const xg = await getEntry('projects', 'expected-goals');
const nested = await getEntry('projects', 'nested-learning');

const into = [
  { em: '📖', k: 'reading', v: 'Gorky' },
  { em: '🎧', k: 'on repeat', v: 'The Smiths' },
  { em: '⚽', k: 'forever', v: 'Barça · Arsenal' },
  { em: '🎬', k: 'comfort', v: 'Good Will Hunting' },
  { em: '🎮', k: 'unwinding', v: 'FC · League' },
];

const toolkit = [
  { label: 'machine learning & research', accent: true, items: ['PyTorch', 'Continual Learning', 'State-Space Models', 'Transfer Learning', 'SHAP', 'Optuna', 'Grad-CAM'] },
  { label: 'languages', accent: false, items: ['Python', 'Java', 'C++', 'SQL', 'Bash', 'R'] },
  { label: 'data engineering & tooling', accent: false, items: ['pandas', 'NumPy', 'scikit-learn', 'ETL / Airflow', 'Azure', 'Docker', 'Git', 'MySQL'] },
];

const today = new Date().toISOString().slice(0, 10);
const footMeta = `bach-nguyen.ipynb · last run ${today} · kernel: python 3`;
---

<BaseLayout
  title="Bach Nguyen — Field Notes"
  description="Student data scientist at Ontario Tech. A notebook of experiments in applied ML, quant, and computer vision — with honest verdicts."
  footMeta={footMeta}
>
  <!-- In [1]: hero -->
  <section class="cell">
    <div class="gutter">In [1]:</div>
    <div class="body-cell">
      <div class="hero-row">
        <div class="avatar"><img src={asset('profile.jpg')} alt="Bach Nguyen" width="92" height="92" /></div>
        <div>
          <p class="eyebrow">student data scientist · oshawa → toronto</p>
          <h1>Bach Nguyen</h1>
          <p class="lead">I build end-to-end ML — and I care most about the parts people skip: honest validation, calibration, and saying so when the model loses.</p>
          <div class="handle">
            <a href="https://github.com/bachnguyennn" target="_blank" rel="noopener">github/bachnguyennn</a>
            <a href="https://www.linkedin.com/in/bach-nguyen-0a50b028a/" target="_blank" rel="noopener">linkedin</a>
            <a href="https://kaggle.com/nguyenvubach" target="_blank" rel="noopener">kaggle</a>
          </div>
          <div class="btn-row">
            <a class="btn primary" href={href('/projects')}>▶ run projects</a>
            <a class="btn" href="#contact">say hi</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- In [2]: README about -->
  <div class="cell-label"># a short README, before the data</div>
  <section class="cell">
    <div class="gutter">In [2]:</div>
    <div class="body-cell md">
      <h2>About me</h2>
      <p>I'm an Integrated Math &amp; Computer Science student at Ontario Tech, somewhere between a mathematician who likes proofs and an engineer who likes things that actually run. A blackboard in a film called <em>Good Will Hunting</em> is genuinely why I started studying math — I never quite got over it.</p>
      <p>Most of my work lives in this notebook: applied ML, a bit of quant, some computer vision. The throughline is that I'd rather report an honest "no edge" than a pretty curve that doesn't replicate. Off the clock I'm watching Barça or Arsenal, replaying The Smiths, or losing to my friends in FC.</p>
    </div>
  </section>

  <!-- In [3]: currently into -->
  <section class="cell">
    <div class="gutter">In [3]:</div>
    <div class="body-cell code"><span class="cmt"># the non-technical context, for the humans reading this</span><br /><span class="fn">me</span>.currently()</div>
  </section>
  <section class="cell">
    <div class="gutter out">Out[3]:</div>
    <div class="body-cell output">
      <div class="into-grid">
        {into.map((i) => (
          <div class="into"><div class="em">{i.em}</div><div class="k">{i.k}</div><div class="v">{i.v}</div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- In [4]: featured xG -->
  <div class="cell-label"># featured projects — full write-ups under /projects</div>
  <section class="cell">
    <div class="gutter">In [4]:</div>
    <div class="body-cell">
      <div class="exp">
        <div>
          <p class="meta-tag">exp_01 · quant / sports analytics · {xg.data.year}</p>
          <h3>{xg.data.title}</h3>
          <p class="muted">{xg.data.summary}</p>
          <div class="chips">{xg.data.tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}</div>
          <div class="verdict"><b>out[ ]:</b> the +5.7% "edge" was statistical noise (95% CI crosses zero). No demonstrable edge vs the close — <b>and that's the correct answer.</b></div>
          <div class="btn-row"><a class="btn" href={href('/projects/expected-goals')}>read notebook →</a><a class="btn" href={xg.data.github} target="_blank" rel="noopener">github</a></div>
        </div>
        <div class="chart">
          <div data-chart="equity"></div>
          <div class="cap">fig 1 · quarter-Kelly bankroll vs the closing line</div>
        </div>
      </div>
    </div>
  </section>

  <!-- In [5]: featured Nested Learning -->
  <section class="cell">
    <div class="gutter">In [5]:</div>
    <div class="body-cell">
      <div class="exp rev">
        <div class="chart">
          <div data-chart="loss"></div>
          <div class="cap">fig 2 · train / val loss on WikiText-103</div>
        </div>
        <div>
          <p class="meta-tag">exp_02 · ml systems research · {nested.data.year}</p>
          <h3>{nested.data.title}</h3>
          <p class="muted">{nested.data.summary}</p>
          <div class="chips">{nested.data.tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}</div>
          <div class="verdict"><b>out[ ]:</b> the memory vault recovers <b>+2.1 ppl</b> over the fast-weight baseline on held-out continuation — ablations isolate where it helps.</div>
          <div class="btn-row"><a class="btn" href={nested.data.github} target="_blank" rel="noopener">github →</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- In [6]: toolkit -->
  <div class="cell-label"># the toolkit</div>
  <section class="cell">
    <div class="gutter">In [6]:</div>
    <div class="body-cell code"><span class="kw">from</span> bach <span class="kw">import</span> toolkit<br />toolkit.<span class="fn">groups</span>()</div>
  </section>
  <section class="cell">
    <div class="gutter out">Out[6]:</div>
    <div class="body-cell output">
      {toolkit.map((g, idx) => (
        <>
          <p class="eyebrow" style={`color:var(--out)${idx ? ';margin-top:1rem' : ''}`}>{g.label}</p>
          <div class="chips">{g.items.map((t) => <span class={g.accent ? 'chip accent' : 'chip'}>{t}</span>)}</div>
        </>
      ))}
    </div>
  </section>

  <!-- In [7]: playful xG of my week -->
  <div class="cell-label"># and because not everything needs to be serious</div>
  <section class="cell">
    <div class="gutter">In [7]:</div>
    <div class="body-cell code"><span class="cmt"># a model with absolutely no business existing</span><br />plt.<span class="fn">bar</span>(week, <span class="fn">predict_joy</span>(week))</div>
  </section>
  <section class="cell">
    <div class="gutter out">Out[7]:</div>
    <div class="body-cell output">
      <div class="chart" style="border:none;box-shadow:none;background:transparent;padding:0">
        <div data-chart="week"></div>
        <div class="cap">fig 3 · "xG of my week" — calibration pending. derby day remains an outlier.</div>
      </div>
    </div>
  </section>

  <!-- In [8]: contact -->
  <div class="cell-label" id="contact"># contact</div>
  <section class="cell">
    <div class="gutter">In [8]:</div>
    <div class="body-cell">
      <div class="callout">
        <span class="label">OPEN TO</span>
        <h3 style="margin:.3rem 0 .4rem">Let's talk models, markets, or football.</h3>
        <p class="muted" style="margin-bottom:.9rem">I'm looking for data science, ML / data engineering, and quant internships — and I'm always happy to chat with peers about a project. Genuinely, just say hi.</p>
        <div class="btn-row">
          <a class="btn primary" href="mailto:vubach.nguyen@ontariotechu.net">✉ email me</a>
          <a class="btn" href={asset('Resume.pdf')} target="_blank" rel="noopener">résumé.pdf</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
