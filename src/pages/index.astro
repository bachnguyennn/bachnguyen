---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projectEntries = await getCollection('projects');
// Homepage shows 3 cards total: the hardcoded Nested Learning card + 2 featured.
// The rest live on the /projects page via "See all projects".
const featuredProjects = projectEntries
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${basePath}${path}`;

const skillGroups = [
  { id: 'ml', label: 'Machine Learning & Research', items: ['PyTorch', 'Continual Learning', 'State-Space Models', 'Fast Linear Attention', 'Transfer Learning', 'SHAP', 'Optuna', 'Grad-CAM'] },
  { id: 'languages', label: 'Languages', items: ['Python', 'Java', 'C++', 'SQL', 'Bash', 'R'] },
  { id: 'data', label: 'Data Engineering & Analysis', items: ['ETL Pipelines', 'pandas', 'NumPy', 'scikit-learn', 'Matplotlib', 'Folium'] },
  { id: 'tooling', label: 'Developer Tools', items: ['Azure Cloud', 'Docker', 'Apache Airflow', 'Power Apps', 'Power Automate', 'Jupyter', 'Git', 'MPS (Apple Silicon)'] },
  { id: 'databases', label: 'Databases & Scraping', items: ['MySQL', 'SQLite', 'IBM DB2', 'BeautifulSoup', 'Web Scraping'] },
];
---

<BaseLayout
  title="Bach | Data Scientist"
  description="Integrated Mathematics and Computer Science student at Ontario Tech University, specializing in neural architecture research, continual learning systems, and quantitative modelling."
>
  <Header />
  <main id="main-content" class="container">
    <section class="hero" id="home">
      <div class="hero-intro">
        <img class="profile-image" src={href('/profile.jpg')} alt="Portrait of Bach" />
        <div class="hero-copy">
          <h1>Hi, I&apos;m Bach</h1>
          <p class="kicker">ML Systems Engineer & Quant</p>
          <p class="lead">
            Integrated Mathematics and Computer Science student at Ontario Tech University,
            specializing in neural architecture research, continual learning systems, and
            quantitative modelling.
          </p>
        </div>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={href('/#projects')}>View Projects</a>
        <a class="btn btn-secondary" href={href('/#contact')}>Get in Touch</a>
      </div>
      <div class="social" aria-label="Social links">
        <a href="https://github.com/bachnguyennn" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/bach-nguyen-0a50b028a/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://kaggle.com/nguyenvubach" target="_blank" rel="noopener noreferrer">Kaggle</a>
      </div>
    </section>

    <section class="section reveal" id="about">
      <header class="section-header">
        <p class="kicker"><span class="section-num">01</span>Background</p>
        <h2>About</h2>
      </header>
      <div class="card">
        <p>
          I am a student data scientist studying Integrated Mathematics and Computer Science at
          Ontario Tech University. I enjoy building practical tools that turn messy data into
          reliable analysis, from cloud data pipelines and scraping workflows to financial modeling
          and automation systems.
        </p>
      </div>
    </section>

    <section class="section reveal" id="projects">
      <header class="section-header">
        <p class="kicker"><span class="section-num">02</span>Work</p>
        <h2>Featured Projects</h2>
      </header>
      <div class="grid grid-2">
        <article class="card project-card" data-domain="ml">
          <div class="project-card-head">
            <h3>Nested Learning Architecture</h3>
            <span class="domain-badge">ML Systems Research</span>
          </div>
          <p class="meta">
            A dual-stream continual learning architecture featuring fast-weight token-level updates
            (cms_fast) and an O(1) memory vault (cms_ultra), with empirical ablation methodology on
            WikiText-103. Designed around capabilities a vanilla transformer cannot replicate.
          </p>
          <p class="meta">Researcher & Builder • 2025–2026</p>
          <div class="tags">
            <span class="tag">PyTorch</span>
            <span class="tag">Continual Learning</span>
            <span class="tag">State-Space Models</span>
            <span class="tag">Fast Weights</span>
            <span class="tag">Ablation Study</span>
          </div>
          <div class="project-actions">
            <a href="https://github.com/bachnguyennn/nested_learning" target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </div>
        </article>
        {featuredProjects.map((project) => (
          <article class="card project-card" data-domain={project.data.domain}>
            <div class="project-card-head">
              <h3>{project.data.title}</h3>
              <span class="domain-badge">
                {project.data.domainLabel ?? project.data.domain.toUpperCase()}
              </span>
            </div>
            <p class="meta">{project.data.summary}</p>
            <p class="meta">{project.data.role} • {project.data.period}</p>
            <div class="tags">
              {project.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <div class="project-actions">
              <a href={href(`/projects/${project.id}`)} class="card-link">Read case study →</a>
              {project.data.github && (
                <a href={project.data.github} target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              )}
              {project.data.demo && (
                <a href={project.data.demo} target="_blank" rel="noopener noreferrer">
                  Live Demo
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
      <p><a class="card-link" href={href('/projects')}>See all projects →</a></p>
    </section>

    <section class="section reveal" id="skills">
      <header class="section-header">
        <p class="kicker"><span class="section-num">03</span>Toolkit</p>
        <h2>Skills</h2>
      </header>
      <div class="skills-grid">
        {skillGroups.map((group) => (
          <article class="card skill-card">
            <h3>{group.label}</h3>
            <div class="skill-list">
              {group.items.map((item) => (
                <span class="skill-chip">{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section reveal" id="education">
      <header class="section-header">
        <p class="kicker"><span class="section-num">04</span>Education</p>
        <h2>Education</h2>
      </header>
      <article class="card">
        <h3>Ontario Tech University</h3>
        <p class="meta">Bachelor of Science in Integrated Mathematics and Computer Science</p>
        <p class="meta">Oshawa, ON • Sep. 2023 - Apr. 2027</p>
        <p class="meta">Cumulative GPA: 3.77 / 4.3</p>
      </article>
    </section>

    <section class="section reveal" id="experience">
      <header class="section-header">
        <p class="kicker"><span class="section-num">05</span>Journey</p>
        <h2>Experience</h2>
      </header>
      <article class="card">
        <h3>IT Intern</h3>
        <p class="meta">Canadian Mental Health Association • Oshawa, ON • May 2025 - Aug. 2025</p>
        <ul class="experience-list">
          <li>Developed automated workflows and booking systems with Microsoft Power Apps and Power Automate.</li>
          <li>Provided IT support and server maintenance for internal systems and clinical software.</li>
          <li>Modernized legacy tools to improve data accessibility and user experience for 100+ employees.</li>
        </ul>
      </article>
      <article class="card">
        <h3>Data Engineer (Volunteer)</h3>
        <p class="meta">Statistics Without Borders • Remote • Feb. 2025</p>
        <ul class="experience-list">
          <li>Architected Azure cloud data pipelines for large-scale biodiversity datasets.</li>
          <li>Improved cloud storage organization to reduce query latency and storage costs.</li>
          <li>Collaborated with statisticians and scientists to align technical work with research standards.</li>
        </ul>
      </article>
      <article class="card">
        <h3>Leadership & Community</h3>
        <p class="meta">Ontario Tech Computer Science Club + Ontario Tech University</p>
        <ul class="experience-list">
          <li>Co-organized hackathons with 250+ participants as Events Coordinator.</li>
          <li>Facilitated technical workshops and networking events for 30+ students.</li>
          <li>Mentored 20 first-year students as a Peer Mentor and Orientation Leader.</li>
        </ul>
      </article>
    </section>

    <section class="section reveal" id="contact">
      <header class="section-header">
        <p class="kicker"><span class="section-num">06</span>Connect With Me</p>
        <h2>Contact</h2>
      </header>
      <div class="card">
        <p>
          I am open to ML research roles, quantitative internships, and technical collaborations in
          machine learning systems or financial modelling.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="mailto:vubach.nguyen@ontariotechu.net">Email Me</a>
          <a class="btn btn-secondary" href={href('/Resume.pdf')} target="_blank" rel="noopener noreferrer">
            See My Resume
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
